# Alibaba Cloud Model Studio (DashScope) OpenAI-compatible endpoint.
# Keep this key server-side. Never add a NEXT_PUBLIC_ prefix.
CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-plus
# Used for image attachments. Compatible providers may use another vision-capable model name.
CHAT_VISION_MODEL=qwen-vl-plus
DASHSCOPE_API_KEY=

# Cyberantt test product catalog API. Keep the token server-side.
CYBERANTT_API_BASE_URL=https://test-2026.cyberantt.com/dev-api
CYBERANTT_API_TOKEN=
# Temporary local development only, scoped to product and cart quote endpoints. Payment always requires a valid HTTPS certificate.
CYBERANTT_ALLOW_INVALID_TEST_CERT=false

# Comma-separated origins allowed to send logged-in customer display data to the assistant iframe.
# https://www.cyberantt.com and the website test origin are allowed by default.
NEXT_PUBLIC_CUSTOMER_PARENT_ORIGINS=
